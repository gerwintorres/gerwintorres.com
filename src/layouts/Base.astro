---
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { experience, profile } from "../data/content";
import { languages, pathInLang, tx, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const t = useTranslations(lang);

// Absolute URLs for search engines and link previews (site is set in astro.config.mjs).
const site = Astro.site ?? new URL("https://gerwintorres.com");
const url = (path: string) => new URL(path, site).href;
const canonical = url(Astro.url.pathname);
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: url(pathInLang(Astro.url.pathname, code)),
}));
const ogImage = url(`/og-${lang}.png`);
const ogLocale: Record<Lang, string> = { en: "en_US", es: "es_CO" };

// Structured data so search engines know who the site is about. The email stays out on purpose.
const currentJob = experience.find((job) => job.end === null);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.shortName,
  url: url("/"),
  image: ogImage,
  jobTitle: tx(profile.role, lang),
  ...(currentJob && {
    worksFor: { "@type": "Organization", name: currentJob.company, url: currentJob.website },
  }),
  address: { "@type": "PostalAddress", addressLocality: "Pereira", addressCountry: "CO" },
  sameAs: [profile.linkedin, profile.github],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1726" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {alternates.map((alt) => (
          <link rel="alternate" hreflang={alt.code} href={alt.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={url("/")} />
      </>
    )}

    <!-- Link previews (LinkedIn, WhatsApp, Slack, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates
      .filter((alt) => alt.code !== lang)
      .map((alt) => (
        <meta property="og:locale:alternate" content={ogLocale[alt.code]} />
      ))}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <!-- Lets CSS know JavaScript runs, so reveal animations never hide content without it. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t("a11y.skip")}
    </a>
    <slot />
    <script>
      // Fades sections in as they enter the viewport.
      const items = document.querySelectorAll(".reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("in");
            observer.unobserve(entry.target);
          });
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      items.forEach((item) => observer.observe(item));
      // Safety net: if the browser never reports an intersection, show everything.
      window.setTimeout(() => items.forEach((item) => item.classList.add("in")), 2500);
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--text);
    color: var(--bg);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }
</style>
