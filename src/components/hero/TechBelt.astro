---
import TechIcon from "../ui/TechIcon.astro";
import { hero } from "../../data/content";
---

<div class="belt" aria-label="Tech stack">
  {[false, true].map((copy) => (
    <ul class="belt-list" role="list" aria-hidden={copy ? "true" : undefined}>
      {hero.belt.map((name) => (
        <li class="belt-item">
          <TechIcon name={name} size={22} />
          <span>{name}</span>
        </li>
      ))}
    </ul>
  ))}
</div>

<script>
  const belt = document.querySelector(".belt");
  if (belt) {
    new IntersectionObserver(([entry]) =>
      belt.classList.toggle("is-playing", entry?.isIntersecting ?? false),
    ).observe(belt);
  }
</script>

<style>
  .belt {
    display: flex;
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: var(--surface-2);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .belt-list {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-8);
    margin: 0;
    padding: var(--space-6) var(--space-4);
    list-style: none;
    animation: slide 45s linear infinite paused;
  }

  /* Moves only while on screen, and stops under the cursor. */
  .belt.is-playing .belt-list {
    animation-play-state: running;
  }

  .belt.is-playing:hover .belt-list {
    animation-play-state: paused;
  }

  .belt-item {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  .belt-item:hover {
    color: var(--text);
  }

  .belt-item:hover :global(.tech-icon) {
    color: var(--brand, var(--accent));
  }

  @keyframes slide {
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .belt {
      overflow-x: auto;
    }

    .belt-list {
      animation: none;
    }

    .belt-list[aria-hidden] {
      display: none;
    }
  }
</style>
