---
import TechIcon from "./TechIcon.astro";

interface Props {
  items: readonly string[];
  tone?: "light" | "panel";
  /** Show each technology's logo before its name. */
  icons?: boolean;
}

const { items, tone = "light", icons = false } = Astro.props;
---

<ul class:list={["chips", tone]} role="list">
  {items.map((item) => (
    <li>
      {icons && <TechIcon name={item} size={14} />}
      {item}
    </li>
  ))}
</ul>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  li :global(.tech-icon) {
    flex-shrink: 0;
    transition: color var(--dur) var(--ease);
  }

  li:hover :global(.tech-icon) {
    color: var(--brand, var(--accent));
  }

  .panel li {
    border-color: rgb(255 255 255 / 0.14);
    background: rgb(255 255 255 / 0.06);
    color: var(--on-panel-muted);
  }
</style>
