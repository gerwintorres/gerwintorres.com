---
import { siGithub } from "simple-icons";

export type IconName =
  | "github"
  | "linkedin"
  | "mail"
  | "arrow-right"
  | "arrow-down"
  | "download"
  | "menu"
  | "close"
  | "map-pin"
  | "external"
  | "database"
  | "cloud"
  | "queue"
  | "bolt"
  | "gear"
  | "check"
  | "code"
  | "sparkle"
  | "webhook"
  | "pipeline"
  | "loop"
  | "board"
  | "chart"
  | "key"
  | "user"
  | "lock";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === "github" && <path d={siGithub.path} fill="currentColor" stroke="none" />}
  {name === "linkedin" && (
    <g fill="currentColor" stroke="none">
      <circle cx="5.2" cy="5.3" r="2.1" />
      <rect x="3.3" y="8.6" width="3.8" height="12.2" rx="0.4" />
      <path d="M9.6 8.6h3.6v1.7c.6-1 1.9-2 3.9-2 3.2 0 4.6 2 4.6 5.6v6.9h-3.8v-6.2c0-1.8-.6-2.9-2.1-2.9-1.6 0-2.4 1.2-2.4 2.9v6.2H9.6Z" />
    </g>
  )}
  {name === "mail" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
    </>
  )}
  {name === "arrow-right" && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {name === "arrow-down" && <path d="M12 5v14m-6-6 6 6 6-6" />}
  {name === "download" && <path d="M12 4v11m-5-5 5 5 5-5M5 20h14" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "map-pin" && (
    <>
      <path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21Z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </>
  )}
  {name === "external" && (
    <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
  )}
  {name === "database" && (
    <>
      <ellipse cx="12" cy="6" rx="7" ry="3" />
      <path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3" />
    </>
  )}
  {name === "cloud" && <path d="M7 18h10a4 4 0 0 0 .5-8A6 6 0 0 0 6.1 11.6 3.3 3.3 0 0 0 7 18Z" />}
  {name === "queue" && (
    <>
      <rect x="4" y="4" width="16" height="4" rx="1" />
      <rect x="4" y="10" width="16" height="4" rx="1" />
      <rect x="4" y="16" width="16" height="4" rx="1" />
    </>
  )}
  {name === "bolt" && <path d="M13 3 5 14h6l-1 7 8-11h-6l1-7Z" />}
  {name === "gear" && (
    <>
      <circle cx="12" cy="12" r="3" />
      <path d="M12 2v3m0 14v3M4.9 4.9 7 7m10 10 2.1 2.1M2 12h3m14 0h3M4.9 19.1 7 17M17 7l2.1-2.1" />
    </>
  )}
  {name === "check" && <path d="M4 12l5 5L20 6" />}
  {name === "code" && <path d="m8 7-5 5 5 5m8-10 5 5-5 5" />}
  {name === "sparkle" && <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8Z" />}
  {name === "webhook" && (
    <>
      <circle cx="6" cy="17" r="2.5" />
      <circle cx="18" cy="17" r="2.5" />
      <circle cx="12" cy="6" r="2.5" />
      <path d="M10.8 8.2 7.2 14.8m6-6.6 3.6 6.6M8.5 17h7" />
    </>
  )}
  {name === "pipeline" && (
    <>
      <rect x="2" y="9" width="6" height="6" rx="1" />
      <rect x="16" y="9" width="6" height="6" rx="1" />
      <path d="M8 12h8m-3-3 3 3-3 3" />
    </>
  )}
  {name === "loop" && (
    <path d="M17 2l3 3-3 3M20 5H9a5 5 0 0 0-5 5m3 12-3-3 3-3m-3 3h11a5 5 0 0 0 5-5" />
  )}
  {name === "board" && (
    <>
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="M9 4v16m6-16v16" />
    </>
  )}
  {name === "chart" && <path d="M4 20V10m6 10V4m6 16v-7m4 7H2" />}
  {name === "key" && (
    <>
      <circle cx="8" cy="15" r="4" />
      <path d="m11 12 9-9m-3 3 3 3m-6 0 2 2" />
    </>
  )}
  {name === "user" && (
    <>
      <circle cx="12" cy="8" r="4" />
      <path d="M4 21a8 8 0 0 1 16 0" />
    </>
  )}
  {name === "lock" && (
    <>
      <rect x="5" y="11" width="14" height="10" rx="2" />
      <path d="M8 11V8a4 4 0 0 1 8 0v3" />
    </>
  )}
</svg>
