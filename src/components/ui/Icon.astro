---
import { siGithub } from "simple-icons";

export type IconName =
  "github" | "linkedin" | "mail" | "arrow-right" | "arrow-down" | "download" | "menu" | "close";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === "github" && <path d={siGithub.path} fill="currentColor" stroke="none" />}
  {name === "linkedin" && (
    <g fill="currentColor" stroke="none">
      <circle cx="5.2" cy="5.3" r="2.1" />
      <rect x="3.3" y="8.6" width="3.8" height="12.2" rx="0.4" />
      <path d="M9.6 8.6h3.6v1.7c.6-1 1.9-2 3.9-2 3.2 0 4.6 2 4.6 5.6v6.9h-3.8v-6.2c0-1.8-.6-2.9-2.1-2.9-1.6 0-2.4 1.2-2.4 2.9v6.2H9.6Z" />
    </g>
  )}
  {name === "mail" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
    </>
  )}
  {name === "arrow-right" && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {name === "arrow-down" && <path d="M12 5v14m-6-6 6 6 6-6" />}
  {name === "download" && <path d="M12 4v11m-5-5 5 5 5-5M5 20h14" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
