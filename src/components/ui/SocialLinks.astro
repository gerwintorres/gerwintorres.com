---
import Icon from "./Icon.astro";
import { profile } from "../../data/content";
import { useTranslations, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
const [emailUser, emailDomain] = profile.email.split("@");
---

<ul class="social" role="list">
  <li>
    <a class="social-link" href={profile.github} target="_blank" rel="noopener" aria-label="GitHub">
      <Icon name="github" />
    </a>
  </li>
  <li>
    <a
      class="social-link"
      href={profile.linkedin}
      target="_blank"
      rel="noopener"
      aria-label="LinkedIn"
    >
      <Icon name="linkedin" />
    </a>
  </li>
  <li>
    <!-- The address is put together in the browser so scrapers don't find it in the HTML. -->
    <a
      class="social-link"
      href="#contact"
      data-email-user={emailUser}
      data-email-domain={emailDomain}
      aria-label={t("cta.email")}
    >
      <Icon name="mail" />
    </a>
  </li>
</ul>

<script>
  document.querySelectorAll<HTMLAnchorElement>("a[data-email-user]").forEach((link) => {
    link.href = `mailto:${link.dataset.emailUser}@${link.dataset.emailDomain}`;
  });
</script>

<style>
  .social {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social-link {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text);
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .social-link:hover {
    border-color: var(--accent);
    color: var(--accent-text);
    transform: translateY(-2px);
  }
</style>
