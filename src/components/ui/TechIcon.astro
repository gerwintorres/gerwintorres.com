---
// Logo for a technology: the brand mark when there is one, otherwise a generic icon.
import Icon from "./Icon.astro";
import { brands, generic, techColor } from "../../lib/techIcons";

interface Props {
  name: string;
  size?: number;
}

const { name, size = 18 } = Astro.props;
const brand = brands[name];
const brandColor = techColor(name);
const fallback = generic[name];
---

{brand ? (
  <svg
    class="tech-icon"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    aria-hidden="true"
    style={brandColor ? `--brand: ${brandColor}` : undefined}
  >
    <path d={brand.path} fill="currentColor" />
  </svg>
) : (
  fallback && <Icon name={fallback} size={size} class="tech-icon" />
)}
