---
// A project's architecture: boxes tinted by technology, the platform they run on, links between
// them, and a highlight that walks the request path step by step.
import TechIcon from "./TechIcon.astro";
import type { Architecture } from "../../data/content";
import { tx, type Lang } from "../../i18n/ui";
import { techColor } from "../../lib/techIcons";

interface Props {
  diagram: Architecture;
  lang: Lang;
}

const { diagram, lang } = Astro.props;
const byId = new Map(diagram.nodes.map((node) => [node.id, node]));
const steps = Math.max(0, ...diagram.nodes.map((node) => node.step ?? 0)) + 1;
const neutral = "#a7b3c4";
---

<div class="arch-scroll">
  <figure
    class="arch"
    style={`--aspect: ${diagram.aspect}; --steps: ${steps}; min-width: ${diagram.minWidth ?? 480}px`}
    role="img"
    aria-label={tx(diagram.summary, lang)}
  >
    {diagram.groups?.map((group) => (
      <div
        class="group"
        style={`left: ${group.x}%; top: ${group.y}%; width: ${group.w}%; height: ${group.h}%; --group: ${group.color ?? neutral}`}
        aria-hidden="true"
      >
        <span class="group-label mono">
          {group.icon && <TechIcon name={group.icon} size={14} />}
          {tx(group.label, lang)}
        </span>
      </div>
    ))}

    <svg class="edges" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {diagram.edges.map((edge) => {
        const from = byId.get(edge.from);
        const to = byId.get(edge.to);
        if (!from || !to) return null;
        return (
          <line
            class:list={["edge", { "in-path": edge.step !== undefined }]}
            x1={from.x}
            y1={from.y}
            x2={to.x}
            y2={to.y}
            style={edge.step !== undefined ? `--step: ${edge.step}` : undefined}
          />
        );
      })}
    </svg>

    {diagram.nodes.map((node) => {
      const color = node.color ?? techColor(node.icon) ?? neutral;
      const step = node.step !== undefined ? ` --step: ${node.step};` : "";
      return (
        <div
          class:list={["node", { "in-path": node.step !== undefined }]}
          style={`left: ${node.x}%; top: ${node.y}%; --node: ${color};${step}`}
          aria-hidden="true"
        >
          {node.icon && <TechIcon name={node.icon} size={16} />}
          <span class="text">
            <span class="label">{tx(node.label, lang)}</span>
            {node.tech && <span class="tech mono">{node.tech}</span>}
          </span>
        </div>
      );
    })}
  </figure>
</div>

<script>
  // Plays each diagram's highlight only while it is on screen.
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => entry.target.classList.toggle("is-playing", entry.isIntersecting));
  });
  document.querySelectorAll(".arch").forEach((diagram) => observer.observe(diagram));
</script>

<style>
  .arch-scroll {
    overflow-x: auto;
    border-radius: var(--radius);
  }

  .arch {
    --beat: 800ms;

    position: relative;
    container-type: inline-size;
    aspect-ratio: var(--aspect);
    margin: 0;
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.1) 1px, transparent 0) 0 0 / 18px 18px,
      linear-gradient(160deg, var(--panel-from), var(--panel-to));
    overflow: hidden;
  }

  .group {
    position: absolute;
    border: 1.5px dashed color-mix(in srgb, var(--group) 85%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--group) 15%, transparent);
  }

  .group-label {
    position: absolute;
    top: 6px;
    left: 10px;
    display: inline-flex;
    gap: 0.4em;
    align-items: center;
    color: var(--group);
    font-size: clamp(9px, 1.4cqw, 12px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .group-label :global(.tech-icon) {
    color: var(--group);
  }

  .edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .edge {
    stroke: rgb(255 255 255 / 0.32);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    vector-effect: non-scaling-stroke;
  }

  /* The highlight only runs while the diagram is on screen, and jumps between steps
     (step-end) so the browser repaints a few times per cycle instead of every frame. */
  .edge.in-path {
    animation: edge-light calc((var(--steps) + 1) * var(--beat)) step-end infinite paused;
    animation-delay: calc(var(--step) * var(--beat));
  }

  .node {
    position: absolute;
    display: flex;
    gap: 0.45em;
    align-items: center;
    padding: 0.4em 0.6em;
    border: 1px solid color-mix(in srgb, var(--node) 55%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--node) 16%, rgb(15 23 38 / 0.9));
    color: var(--on-panel);
    font-size: clamp(10px, 1.7cqw, 13px);
    line-height: 1.15;
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .node.in-path {
    animation: node-light calc((var(--steps) + 1) * var(--beat)) step-end infinite paused;
    animation-delay: calc(var(--step) * var(--beat));
  }

  .arch.is-playing .node.in-path,
  .arch.is-playing .edge.in-path {
    animation-play-state: running;
  }

  .node :global(.tech-icon) {
    flex-shrink: 0;
    width: 1.35em;
    height: 1.35em;
    color: var(--node);
  }

  .text {
    display: grid;
  }

  .label {
    font-weight: 600;
  }

  .tech {
    color: color-mix(in srgb, var(--node) 45%, var(--on-panel-muted));
    font-size: 0.8em;
  }

  @keyframes node-light {
    0%,
    26%,
    100% {
      border-color: color-mix(in srgb, var(--node) 55%, transparent);
      box-shadow: none;
    }

    4%,
    18% {
      border-color: var(--orange-400);
      box-shadow: 0 0 0 3px rgb(242 128 63 / 0.28);
    }
  }

  @keyframes edge-light {
    0%,
    24%,
    100% {
      stroke: rgb(255 255 255 / 0.32);
    }

    2%,
    16% {
      stroke: var(--orange-400);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edge.in-path,
    .node.in-path {
      animation: none;
    }

    .edge.in-path {
      stroke: rgb(242 128 63 / 0.7);
    }
  }
</style>
