---
// A project's architecture: boxes tinted by technology, the platform they run on, links between
// them, and a highlight that walks the request path beat by beat, including the way back.
import TechIcon from "./TechIcon.astro";
import type { Architecture, Steps } from "../../data/content";
import { tx, type Lang } from "../../i18n/ui";
import { techColor } from "../../lib/techIcons";

interface Props {
  diagram: Architecture;
  lang: Lang;
}

const { diagram, lang } = Astro.props;
const byId = new Map(diagram.nodes.map((node) => [node.id, node]));
const list = (steps?: Steps): number[] => (steps === undefined ? [] : [steps].flat());
const lastStep = Math.max(
  0,
  ...[...diagram.nodes, ...diagram.edges].flatMap((part) => list(part.step)),
);
// Every step of the path plus one quiet beat before it starts over.
const beats = lastStep + 2;
const neutral = "#a7b3c4";
---

<div class="arch-scroll">
  <figure
    class="arch"
    style={`--aspect: ${diagram.aspect}; min-width: ${diagram.minWidth ?? 480}px`}
    data-beats={beats}
    role="img"
    aria-label={tx(diagram.summary, lang)}
  >
    {diagram.groups?.map((group) => (
      <div
        class="group"
        style={`left: ${group.x}%; top: ${group.y}%; width: ${group.w}%; height: ${group.h}%; --group: ${group.color ?? neutral}`}
        aria-hidden="true"
      >
        <span class="group-label mono">
          {group.icon && <TechIcon name={group.icon} size={14} />}
          {tx(group.label, lang)}
        </span>
      </div>
    ))}

    <svg class="edges" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {diagram.edges.map((edge) => {
        const from = byId.get(edge.from);
        const to = byId.get(edge.to);
        if (!from || !to) return null;
        const points = [[from.x, from.y], ...(edge.via ?? []), [to.x, to.y]]
          .map(([x, y]) => `${x},${y}`)
          .join(" ");
        const steps = list(edge.step);
        return (
          <polyline
            class:list={["edge", { "in-path": steps.length > 0 }]}
            points={points}
            data-steps={steps.length > 0 ? steps.join(" ") : undefined}
          />
        );
      })}
    </svg>

    {diagram.nodes.map((node) => {
      const color = node.color ?? techColor(node.icon) ?? neutral;
      const steps = list(node.step);
      return (
        <div
          class="node"
          style={`left: ${node.x}%; top: ${node.y}%; --node: ${color}`}
          data-steps={steps.length > 0 ? steps.join(" ") : undefined}
          aria-hidden="true"
        >
          {node.icon && <TechIcon name={node.icon} size={16} />}
          <span class="text">
            <span class="label">{tx(node.label, lang)}</span>
            {node.tech && <span class="tech mono">{node.tech}</span>}
          </span>
        </div>
      );
    })}
  </figure>
</div>

<script>
  // Walks each diagram's request path one beat at a time, only while the diagram is on screen.
  // A single timer per visible diagram swaps a class a few times per cycle, so the page does
  // not repaint every frame.
  const BEAT_MS = 800;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const timers = new Map<HTMLElement, number>();

  function play(diagram: HTMLElement) {
    const beats = Number(diagram.dataset.beats);
    const parts = Array.from(
      diagram.querySelectorAll<HTMLElement | SVGElement>("[data-steps]"),
      (part) => ({ part, steps: (part.dataset.steps ?? "").split(" ").map(Number) }),
    );
    let beat = 0;
    const tick = () => {
      parts.forEach(({ part, steps }) => part.classList.toggle("lit", steps.includes(beat)));
      beat = (beat + 1) % beats;
    };
    tick();
    timers.set(diagram, window.setInterval(tick, BEAT_MS));
  }

  function stop(diagram: HTMLElement) {
    window.clearInterval(timers.get(diagram));
    timers.delete(diagram);
    diagram.querySelectorAll(".lit").forEach((part) => part.classList.remove("lit"));
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(({ target, isIntersecting }) => {
      const diagram = target as HTMLElement;
      if (!isIntersecting) stop(diagram);
      else if (!timers.has(diagram) && !reducedMotion.matches) play(diagram);
    });
  });
  document.querySelectorAll<HTMLElement>(".arch").forEach((diagram) => observer.observe(diagram));
</script>

<style>
  .arch-scroll {
    overflow-x: auto;
    border-radius: var(--radius);
  }

  .arch {
    position: relative;
    container-type: inline-size;
    aspect-ratio: var(--aspect);
    margin: 0;
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.1) 1px, transparent 0) 0 0 / 18px 18px,
      linear-gradient(160deg, var(--panel-from), var(--panel-to));
    overflow: hidden;
  }

  .group {
    position: absolute;
    border: 1.5px dashed color-mix(in srgb, var(--group) 85%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--group) 15%, transparent);
  }

  .group-label {
    position: absolute;
    top: 6px;
    left: 10px;
    display: inline-flex;
    gap: 0.4em;
    align-items: center;
    color: var(--group);
    font-size: clamp(9px, 1.4cqw, 12px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .group-label :global(.tech-icon) {
    color: var(--group);
  }

  .edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .edge {
    fill: none;
    stroke: rgb(255 255 255 / 0.32);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .edge.lit {
    stroke: var(--orange-400);
  }

  .node {
    position: absolute;
    display: flex;
    gap: 0.45em;
    align-items: center;
    padding: 0.4em 0.6em;
    border: 1px solid color-mix(in srgb, var(--node) 55%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--node) 16%, rgb(15 23 38 / 0.9));
    color: var(--on-panel);
    font-size: clamp(10px, 1.7cqw, 13px);
    line-height: 1.15;
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .node.lit {
    border-color: var(--orange-400);
    box-shadow: 0 0 0 3px rgb(242 128 63 / 0.28);
  }

  .node :global(.tech-icon) {
    flex-shrink: 0;
    width: 1.35em;
    height: 1.35em;
    color: var(--node);
  }

  .text {
    display: grid;
  }

  .label {
    font-weight: 600;
  }

  .tech {
    color: color-mix(in srgb, var(--node) 45%, var(--on-panel-muted));
    font-size: 0.8em;
  }

  /* Without motion the path stays drawn in orange, so the route still reads. */
  @media (prefers-reduced-motion: reduce) {
    .edge.in-path {
      stroke: rgb(242 128 63 / 0.7);
    }
  }
</style>
