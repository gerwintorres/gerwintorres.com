---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Hero from "./hero/Hero.astro";
import TechBelt from "./hero/TechBelt.astro";
import About from "./sections/About.astro";
import Experience from "./sections/Experience.astro";
import Projects from "./sections/Projects.astro";
import Skills from "./sections/Skills.astro";
import { hero, profile } from "../data/content";
import { tx, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Base
  lang={lang}
  title={`${profile.name} · ${tx(profile.role, lang)}`}
  description={tx(hero.tagline, lang)}
>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <TechBelt />
    <About lang={lang} />
    <Experience lang={lang} />
    <Projects lang={lang} />
    <Skills lang={lang} />
  </main>
</Base>
