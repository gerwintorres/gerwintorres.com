---
import SectionHeading from "../ui/SectionHeading.astro";
import { education, sections } from "../../data/content";
import { tx, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const kinds = {
  degree: { en: "Degree", es: "Pregrado" },
  certification: { en: "Certification", es: "Certificación" },
  talk: { en: "Talk", es: "Charla" },
} as const;
---

<section class="section" id="education" aria-labelledby="education-title">
  <div class="container">
    <SectionHeading
      id="education"
      eyebrow={tx(sections.education.eyebrow, lang)}
      title={tx(sections.education.title, lang)}
    />

    <ul class="grid" role="list">
      {education.map((item) => (
        <li class="card reveal">
          <p class="top">
            <span class="kind">{tx(kinds[item.kind], lang)}</span>
            <span class="period mono">{tx(item.period, lang)}</span>
          </p>
          <h3>{tx(item.title, lang)}</h3>
          <p class="place">{tx(item.place, lang)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: center;
  }

  .kind {
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .period {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
  }

  .place {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
