---
import ArchDiagram from "../ui/ArchDiagram.astro";
import Chips from "../ui/Chips.astro";
import Icon from "../ui/Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { projects, sections } from "../../data/content";
import { tx, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <SectionHeading
      id="projects"
      eyebrow={tx(sections.projects.eyebrow, lang)}
      title={tx(sections.projects.title, lang)}
    />

    <ul class="grid" role="list">
      {projects.map((project, i) => (
        <li class:list={["card reveal", { featured: i === 0 }]}>
          <ArchDiagram diagram={project.architecture} lang={lang} />

          <div class="head">
            <div class="titles">
              <p class="kind mono">{tx(project.kind, lang)}</p>
              <h3>{tx(project.title, lang)}</h3>
            </div>
            {project.links.length > 0 && (
              <p class="links">
                {project.links.map((link) => (
                  <a class="link-button" href={link.href} target="_blank" rel="noopener">
                    <Icon name={link.icon ?? "external"} size={16} />
                    {tx(link.label, lang)}
                  </a>
                ))}
              </p>
            )}
          </div>

          <div class="body">
            <p class="summary">{tx(project.summary, lang)}</p>
            <ul class="highlights" role="list">
              {project.highlights.map((highlight) => (
                <li>{tx(highlight, lang)}</li>
              ))}
            </ul>
            <Chips items={project.stack} icons />
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: border-color var(--dur) var(--ease);
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }

  .featured {
    grid-column: 1 / -1;
  }

  /* Title on the left and the link button on the same line, on the right. */
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-2) 0;
  }

  .titles {
    display: grid;
    flex: 1 1 12rem;
    gap: var(--space-2);
  }

  .kind {
    color: var(--accent-text);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h3 {
    font-size: var(--text-xl);
    font-weight: 800;
    line-height: 1.2;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-left: auto; /* stays on the right even when it wraps below the title */
  }

  .link-button {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    min-height: 40px;
    padding-inline: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--line));
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .link-button:hover {
    background: color-mix(in srgb, var(--accent) 22%, var(--surface));
    transform: translateY(-2px);
  }

  .body {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: 0 var(--space-2) var(--space-2);
  }

  .featured .body {
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-8);
  }

  /* Summary and highlights side by side; the stack runs the full width underneath. */
  .featured .highlights {
    grid-column: 2;
  }

  .featured .body > :global(.chips) {
    grid-column: 1 / -1;
    margin-top: var(--space-2);
  }

  .summary,
  .highlights {
    color: var(--text-muted);
  }

  .highlights {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    padding: 0;
    font-size: var(--text-sm);
    list-style: none;
  }

  .highlights li {
    position: relative;
    padding-left: var(--space-4);
  }

  .highlights li::before {
    content: "";
    position: absolute;
    top: 0.6em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (max-width: 860px) {
    .grid,
    .featured .body {
      grid-template-columns: 1fr;
    }

    .featured .highlights,
    .featured .body > :global(.chips) {
      grid-column: auto;
    }

    .featured .body > :global(.chips) {
      margin-top: 0;
    }
  }
</style>
