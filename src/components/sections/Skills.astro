---
import SectionHeading from "../ui/SectionHeading.astro";
import { sections, skills } from "../../data/content";
import { tx, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="section alt" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <SectionHeading
      id="skills"
      eyebrow={tx(sections.skills.eyebrow, lang)}
      title={tx(sections.skills.title, lang)}
    />

    <ol class="layers reveal" role="list">
      {skills.map((group) => (
        <li class="layer">
          <span class="code mono" aria-hidden="true">
            {group.code}
          </span>
          <h3>{tx(group.layer, lang)}</h3>
          <ul class="items" role="list">
            {group.items.map((item) => (
              <li>{tx(item, lang)}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
    <p class="note">{tx(sections.skills.note, lang)}</p>
  </div>
</section>

<style>
  .layers {
    display: grid;
    gap: var(--space-2);
    max-width: 900px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .layer {
    display: grid;
    grid-template-columns: 56px 170px 1fr;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .layer:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    transform: translateX(4px);
  }

  .code {
    display: grid;
    place-items: center;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--text);
    color: var(--bg);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  h3 {
    font-size: var(--text-base);
    font-weight: 700;
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .items li {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .note {
    margin-top: var(--space-6);
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  @media (max-width: 700px) {
    .layer {
      grid-template-columns: 48px 1fr;
    }

    .items {
      grid-column: 1 / -1;
    }
  }
</style>
