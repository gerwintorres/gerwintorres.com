---
import Chips from "../ui/Chips.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { experience, sections } from "../../data/content";
import { tx, useTranslations, type Lang, type Localized } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = (ym: string): string => ym.split("-")[0] ?? ym;
const month = (ym: string): string => {
  const [y, m] = ym.split("-").map(Number);
  return new Intl.DateTimeFormat(lang, { month: "short", year: "numeric" }).format(
    new Date(y ?? 2000, (m ?? 1) - 1),
  );
};
const years = (start: string, end: string | null): string => {
  const from = year(start);
  const to = end ? year(end) : t("date.present");
  return from === to ? from : `${from} – ${to}`;
};

/** One tab per company, and one per client inside a company. */
interface Entry {
  id: string;
  group: string;
  isClient: boolean;
  tab: string;
  title: string;
  at: string;
  start: string;
  end: string | null;
  meta: Localized[];
  summary: Localized;
  highlights: Localized[];
  stack: string[];
}

const entries: Entry[] = experience.flatMap((job) => [
  {
    id: job.id,
    group: job.id,
    isClient: false,
    tab: job.company,
    title: tx(job.role, lang),
    at: job.company,
    start: job.start,
    end: job.end,
    meta: [job.type, job.location],
    summary: job.summary,
    highlights: job.highlights,
    stack: job.stack,
  },
  ...(job.clients ?? []).map((client) => ({
    id: `${job.id}-${client.id}`,
    group: job.id,
    isClient: true,
    tab: tx(client.tab, lang),
    title: tx(client.name, lang),
    at: job.company,
    start: client.start,
    end: client.end,
    meta: [client.role, client.type, client.location].filter((m): m is Localized => !!m),
    summary: client.summary,
    highlights: client.highlights,
    stack: client.stack,
  })),
]);
---

<section class="section alt" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <SectionHeading
      id="experience"
      eyebrow={tx(sections.experience.eyebrow, lang)}
      title={tx(sections.experience.title, lang)}
    />

    <div class="xp reveal">
      <div class="tabs" role="tablist" aria-label={tx(sections.experience.eyebrow, lang)}>
        {experience.map((job) => {
          const own = entries.filter((e) => e.group === job.id);
          const [parent, ...clients] = own;
          const open = job.id === entries[0]?.group;
          return (
            <div class:list={["group", { "is-open": open }]} data-group={job.id}>
              {parent && (
                <button
                  class="tab"
                  type="button"
                  role="tab"
                  id={`xp-tab-${parent.id}`}
                  aria-controls={`xp-panel-${parent.id}`}
                  aria-selected={parent.id === entries[0]?.id ? "true" : "false"}
                  tabindex={parent.id === entries[0]?.id ? 0 : -1}
                >
                  <span class="tab-name">{parent.tab}</span>
                  <span class="tab-years mono">{years(parent.start, parent.end)}</span>
                </button>
              )}
              {clients.length > 0 && (
                <div class="subtabs" role="presentation">
                  {clients.map((client) => (
                    <button
                      class="tab subtab"
                      type="button"
                      role="tab"
                      id={`xp-tab-${client.id}`}
                      aria-controls={`xp-panel-${client.id}`}
                      aria-selected="false"
                      tabindex="-1"
                    >
                      <span class="tab-name">{client.tab}</span>
                      <span class="tab-years mono">{years(client.start, client.end)}</span>
                    </button>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>

      {entries.map((entry, i) => (
        <article
          class="panel"
          role="tabpanel"
          id={`xp-panel-${entry.id}`}
          aria-labelledby={`xp-tab-${entry.id}`}
          hidden={i !== 0}
        >
          {entry.isClient && (
            <p class="client-of mono">
              {t("xp.client")} {entry.at}
            </p>
          )}
          <h3>
            {entry.title}
            {!entry.isClient && <span class="at"> @ {entry.at}</span>}
          </h3>
          <p class="meta">
            <span class="mono">
              {month(entry.start)} – {entry.end ? month(entry.end) : t("date.present")}
            </span>
            {entry.meta.map((m) => (
              <span>{tx(m, lang)}</span>
            ))}
          </p>
          <p class="summary">{tx(entry.summary, lang)}</p>
          <ul class="highlights" role="list">
            {entry.highlights.map((highlight) => (
              <li>{tx(highlight, lang)}</li>
            ))}
          </ul>
          <Chips items={entry.stack} />
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Accessible tabs. A company's clients unfold under it while the company or one of them is selected.
  document.querySelectorAll<HTMLElement>(".xp").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const groups = [...root.querySelectorAll<HTMLElement>(".group")];

    function visibleTabs(): HTMLButtonElement[] {
      return tabs.filter((tab) => tab.offsetParent !== null);
    }

    function select(tab: HTMLButtonElement, focus = false): void {
      tabs.forEach((other) => {
        const selected = other === tab;
        other.setAttribute("aria-selected", String(selected));
        other.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(other.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !selected;
      });
      const group = tab.closest<HTMLElement>(".group");
      groups.forEach((g) => g.classList.toggle("is-open", g === group));
      if (focus) tab.focus();
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const visible = visibleTabs();
        const i = visible.indexOf(tab);
        const moves: Record<string, number> = {
          ArrowDown: i + 1,
          ArrowRight: i + 1,
          ArrowUp: i - 1,
          ArrowLeft: i - 1,
          Home: 0,
          End: visible.length - 1,
        };
        const next = moves[event.key];
        if (next === undefined) return;
        event.preventDefault();
        const target = visible[(next + visible.length) % visible.length];
        if (target) select(target, true);
      });
    });
  });
</script>

<style>
  .xp {
    display: grid;
    grid-template-columns: 270px 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .tabs {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .group {
    display: grid;
    gap: var(--space-1);
  }

  .tab {
    display: grid;
    gap: 2px;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .tab:hover {
    background: var(--surface-2);
  }

  .tab[aria-selected="true"] {
    background: var(--text);
    color: var(--bg);
  }

  .tab-name {
    font-weight: 700;
  }

  .tab-years {
    font-size: var(--text-xs);
    opacity: 0.75;
  }

  .subtabs {
    display: none;
    gap: var(--space-1);
    margin: var(--space-1) 0 var(--space-2) var(--space-4);
    padding-left: var(--space-3);
    border-left: 2px solid var(--accent);
  }

  .group.is-open .subtabs {
    display: grid;
  }

  .subtab {
    padding-block: var(--space-2);
  }

  .subtab .tab-name {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .panel {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-8);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .panel[hidden] {
    display: none;
  }

  .client-of {
    color: var(--accent-text);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    font-size: var(--text-xl);
    font-weight: 800;
  }

  .at {
    color: var(--accent-text);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .summary {
    color: var(--text-muted);
  }

  .highlights {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .highlights li {
    position: relative;
    padding-left: var(--space-6);
  }

  .highlights li::before {
    content: "";
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 10px;
    height: 2px;
    background: var(--accent);
  }

  @media (max-width: 860px) {
    .xp {
      grid-template-columns: 1fr;
    }

    .panel {
      padding: var(--space-6);
    }
  }
</style>
