---
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<button
  class="theme-toggle"
  type="button"
  data-label-light={t("theme.toLight")}
  data-label-dark={t("theme.toDark")}
  aria-label={t("theme.toDark")}
>
  <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" fill="currentColor"></path>
  </svg>
  <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
    <path
      d="M12 2v2.5M12 19.5V22M4.2 4.2 6 6M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    ></path>
  </svg>
</button>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".theme-toggle");

  function sync(): void {
    const dark = document.documentElement.dataset.theme === "dark";
    buttons.forEach((button) => {
      button.setAttribute(
        "aria-label",
        (dark ? button.dataset.labelLight : button.dataset.labelDark) ?? "",
      );
    });
  }

  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      sync();
    }),
  );

  sync();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease);
  }

  .theme-toggle:hover {
    border-color: var(--accent);
  }

  .icon-sun,
  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }

  :global([data-theme="dark"]) .icon-sun {
    display: block;
  }
</style>
