---
// Temporary home: proves the layout, themes and languages work before the sections land.
import Base from "../layouts/Base.astro";
import LangSwitch from "./LangSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { hero, profile } from "../data/content";
import { tx, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Base
  lang={lang}
  title={`${profile.name} · ${tx(profile.role, lang)}`}
  description={tx(hero.tagline, lang)}
>
  <main id="main" class="container home">
    <div class="controls">
      <LangSwitch lang={lang} />
      <ThemeToggle lang={lang} />
    </div>
    <p class="eyebrow mono">{tx(hero.eyebrow, lang)}</p>
    <h1>
      {profile.firstName}
      <span>{profile.lastName}</span>
    </h1>
    <p class="tagline">{tx(hero.tagline, lang)}</p>
  </main>
</Base>

<style>
  .home {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-16);
  }

  .controls {
    display: flex;
    gap: var(--space-2);
    justify-content: flex-end;
  }

  .eyebrow {
    color: var(--accent-text);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 800;
  }

  h1 span {
    display: block;
    color: var(--accent);
  }

  .tagline {
    max-width: 60ch;
    color: var(--text-muted);
    font-size: var(--text-lg);
  }
</style>
